# Copy to .env — never commit .env
ENVIRONMENT=development

# AI Refinery — get your key at https://airefinery.accenture.com
AIREFINERY_API_KEY=

# Model selection (see https://sdk.airefinery.accenture.com/distiller/model_catalog/)
AIR_MODEL=openai/gpt-oss-120b

# Control plane URL (used by SDK plugin and dashboard)
CONTROL_PLANE_URL=http://localhost:8001
