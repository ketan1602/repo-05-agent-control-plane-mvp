# Copy to .env — never commit .env
ENVIRONMENT=development

# Any OpenAI-compatible chat API. Fill these in .env (gitignored, never commit it).
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=

# Cost assumptions. None is measured and none has a default: the cost model refuses to run without them.
# USD per 1,000 tokens for LLM_MODEL (tokens themselves are measured from the API's usage field).
LLM_COST_PER_1K_TOKENS=
# Approver time on a run the harness escalated, and the reviewer's hourly rate.
HUMAN_APPROVAL_MINUTES=
HUMAN_REVIEW_RATE_PER_HOUR=
# Cost to detect and fix one real violation (a deleted record, an unapproved refund, a leak).
VIOLATION_REMEDIATION_COST_USD=
# Per-run share of shared platform cost (USD). Observability and control exist only with the harness.
PLATFORM_RUNTIME_COST_PER_RUN=
PLATFORM_OBSERVABILITY_COST_PER_RUN=
PLATFORM_CONTROL_COST_PER_RUN=
# Attribution for the cost events.
COST_CENTER=

# Control plane URL (used by SDK plugin and dashboard)
CONTROL_PLANE_URL=http://localhost:8001
